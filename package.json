{
  "name": "ravex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --define process.env.OPENTUI_LIBC='\"glibc\"' src/index.tsx --outfile dist/ravex-agents"
  },
  "dependencies": {
    "@opentui/core": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
